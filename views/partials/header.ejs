				<!-- Header -->
					<header id="header">
						<h1><a href="/<%= lang %>/"><%= site.name %></a></h1>
						<nav class="links">
							<ul>
								<li><a href="/<%= lang %>/"><%= t('nav.home') %></a></li>
								<% categories.slice(0, 4).forEach(function (c) { %>
								<li><a href="/<%= lang %>/category/<%= c.slug %>"><%= c.name %></a></li>
								<% }); %>
								<li><a href="/<%= lang %>/about"><%= t('nav.about') %></a></li>
							</ul>
						</nav>
						<nav class="main">
							<ul>
								<li class="lang">
									<a class="lang-switch" href="<%= altPaths[otherLang] || '/' + otherLang + '/' %>" hreflang="<%= otherLang %>" lang="<%= otherLang %>" title="<%= t('menu.switch_language') %>"><%= otherLang.toUpperCase() %></a>
								</li>
								<li class="search">
									<a class="fa-search" href="#search"><%= t('nav.search') %></a>
									<form id="search" method="get" action="/<%= lang %>/search">
										<input type="text" name="q" placeholder="<%= t('search.placeholder') %>" />
									</form>
								</li>
								<li class="menu">
									<a class="fa-bars" href="#menu"><%= t('nav.menu') %></a>
								</li>
							</ul>
						</nav>
					</header>
