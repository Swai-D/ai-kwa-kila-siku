<%- include('partials/top', { title: 'Subscribers', actions: '<a href="/admin/subscribers.csv" class="btn btn-primary"><i class="mdi mdi-download me-1"></i> Export CSV</a>', styles: ['/admin-assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css'] }) %>
                        <div class="row">
                            <% [['Total', counts.all], ['Kiswahili', counts.sw], ['English', counts.en]].forEach(function (c) { %>
                            <div class="col-md-4 col-sm-6">
                                <div class="card"><div class="card-body">
                                    <span class="text-muted d-block mb-2"><%= c[0] %></span>
                                    <h4 class="mb-0"><%= c[1] %></h4>
                                </div></div>
                            </div>
                            <% }); %>
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <% if (!rows.length) { %>
                                <p class="text-muted mb-0">No subscribers yet. The signup form is in the blog sidebar.</p>
                                <% } else { %>
                                <table id="subscribers-table" class="table table-bordered w-100 align-middle">
                                    <thead><tr><th>Email</th><th>Language</th><th>Subscribed (EAT)</th><th class="no-sort text-end">Actions</th></tr></thead>
                                    <tbody>
                                    <% rows.forEach(function (r) { %>
                                        <tr>
                                            <td><%= r.email %></td>
                                            <td><span class="badge bg-<%= r.lang === 'sw' ? 'primary' : 'info' %>-subtle text-<%= r.lang === 'sw' ? 'primary' : 'info' %>"><%= r.lang.toUpperCase() %></span></td>
                                            <td data-order="<%= r.created_at %>"><%= formatEat(r.created_at) %></td>
                                            <td class="text-end">
                                                <form method="post" action="/admin/subscribers/<%= r.id %>/delete" class="d-inline js-confirm-delete" data-what="subscriber" data-title="<%= r.email %>" data-note="They will no longer be on your list.">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                                    <button type="submit" class="btn btn-sm btn-soft-danger" title="Delete"><i class="mdi mdi-delete"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                    </tbody>
                                </table>
                                <% } %>
                            </div>
                        </div>
<%- include('partials/bottom', { scripts: ['/admin-assets/libs/datatables.net/js/jquery.dataTables.min.js', '/admin-assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js'] }) %>
