<%- include('partials/top') %>
						<article class="post">
							<header>
								<div class="title">
									<h2><%= heading %></h2>
									<% if (subheading) { %><p><%= subheading %></p><% } %>
								</div>
							</header>
						</article>
						<% result.rows.forEach(function (post) { %>
						<%- include('partials/post-card', { post: post }) %>
						<% }); %>
						<% if (!result.rows.length) { %><article class="post"><p><%= t(typeof emptyKey !== 'undefined' ? emptyKey : 'list.empty') %></p></article><% } %>
						<%- include('partials/pagination') %>
<%- include('partials/bottom') %>
